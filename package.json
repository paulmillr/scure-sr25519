{
  "name": "@scure/sr25519",
  "version": "2.3.0",
  "description": "Audited & minimal implementation of sr25519 (polkadot) cryptography, with Merlin and Strobe",
  "files": [
    "index.js",
    "index.d.ts",
    "index.ts"
  ],
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@paulmillr/jsbt": "0.7.2",
    "bismar": "0.1.9",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "scripts": {
    "benchmark:size": "bismar -bsm",
    "build": "tsc",
    "check": "jsbt-check",
    "benchmark": "cd test/benchmark; npm i; node index.ts",
    "format": "prettier --write index.ts 'test/**/*.{js,ts}'",
    "test": "node test/index.ts"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "keywords": [
    "sr25519",
    "polkadot",
    "merlin",
    "strobe",
    "schnorr",
    "schnorrkel",
    "ristretto",
    "hdkd",
    "ed25519"
  ],
  "homepage": "https://paulmillr.com/noble/#scure",
  "funding": "https://paulmillr.com/funding/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulmillr/scure-sr25519.git"
  },
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "author": "Paul Miller (https://paulmillr.com)",
  "license": "MIT"
}
